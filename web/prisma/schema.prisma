generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Run {
  id          String       @id
  caseId      String
  generatedAt DateTime     @default(now())
  manifest    Json
  summaries   Assessment[]
  comparisons Comparison[]
  auditEvents AuditEvent[]
}

model Assessment {
  id                          String @id
  runId                       String
  findingId                 String
  assetId                   String
  cve                        String
  vulnerabilityType           String
  state                     String
  baseScore                  Float
  environmentalScore          Float
  cr                         String
  ir                         String
  ar                         String
  mav                        String
  matchesExpectedRequirements Boolean
  run                        Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
  @@index([findingId])
}

model Comparison {
  id                    String @id
  runId                String
  findingId           String
  assetId             String
  cve                 String
  vulnerabilityType   String
  environmentalBefore   Float
  environmentalAfter    Float
  delta               Float
  effect             String
  mavBefore          String
  mavAfter           String
  beforeMatchesExpected Boolean
  afterMatchesExpected  Boolean
  raw                 Json
  run                 Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
  @@index([effect])
}

model AuditEvent {
  id      String @id
  runId   String
  ordinal Int
  event   Json
  run     Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
}

// ============================================================================
// Auth-1A additive authentication and tenant schema
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  ADMIN
  OPERATOR
  REVIEWER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum EnvironmentStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  emailVerified         Boolean              @default(false)
  image                 String?
  status                UserStatus           @default(ACTIVE)
  platformRole          PlatformRole         @default(USER)
  suspendedAt           DateTime?
  disabledAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  accounts              Account[]
  sessions              Session[]
  memberships           Membership[]
  createdInvitations    Invitation[]         @relation("InvitationCreatedBy")
  acceptedInvitations   Invitation[]         @relation("InvitationAcceptedBy")
  passwordResetTokens   PasswordResetToken[]
  securityAuditEvents   SecurityAuditEvent[] @relation("SecurityAuditActor")

  @@index([status])
  @@index([platformRole])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  status              OrganizationStatus   @default(ACTIVE)
  suspendedAt         DateTime?
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  projects            Project[]
  invitations         Invitation[]
  securityAuditEvents SecurityAuditEvent[]

  @@index([status])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  suspendedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments   Environment[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Environment {
  id        String            @id @default(cuid())
  projectId String
  name      String
  slug      String
  status    EnvironmentStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId, status])
}

model Invitation {
  id               String         @id @default(cuid())
  organizationId   String
  email            String
  role             MembershipRole
  tokenHash        String         @unique @db.Text
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdByUserId  String
  acceptedByUserId String?
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?          @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([email, expiresAt])
  @@index([createdByUserId])
  @@index([acceptedByUserId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.Text
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SecurityAuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser      User?         @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}
